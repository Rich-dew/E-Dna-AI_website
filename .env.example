# Server-side Gemini API key (never expose with VITE_ prefix)
GEMINI_API_KEY=

# Application URL
APP_URL=http://localhost:3000

# Firebase Web SDK configuration (public client keys from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase configuration (NEVER place service_role key in client variables)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Hidden admin route path (default: /control-9x7k)
VITE_ADMIN_ROUTE=/control-9x7k

# Server-only second-step admin passcode (verified on Express backend)
ADMIN_PASSCODE=
